---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Base title="Support" description={`Support ${site.name}'s free WoW: Forever addons.`}>
  <section class="section container">
    <div class="support card">
      <p class="eyebrow">Support</p>
      <h1>Buy me a coffee</h1>
      <p class="lead">
        The addons are free. If one saves you time or gold, a coffee helps pay for the hours that go into keeping them
        working through Forever's beta patches.
      </p>
      {
        site.buyMeACoffee ? (
          <a class="button button-primary coffee" href={site.buyMeACoffee}>
            <Icon name="coffee" /> Buy me a coffee
          </a>
        ) : (
          <p class="soon">My Buy Me a Coffee page is on its way. Thanks for checking!</p>
        )
      }
    </div>
  </section>

  <section class="section-tight container" aria-labelledby="other">
    <h2 id="other">Other ways to help</h2>
    <ul class="ways">
      <li class="card">
        <h3>Report a problem</h3>
        <p class="muted">
          Leave a comment on the addon's CurseForge page with your class, level and what happened. Small details fix
          bugs fast.
        </p>
      </li>
      <li class="card">
        <h3>Suggest an idea</h3>
        <p class="muted">Missing an item, a dungeon or a setting? Say so in the comments.</p>
      </li>
      <li class="card">
        <h3>Tell your guild</h3>
        <p class="muted">Most players find addons through friends. Sharing a link to this site or CurseForge helps a lot.</p>
      </li>
    </ul>
  </section>
</Base>

<style>
  .support {
    display: grid;
    gap: 18px;
    justify-items: start;
    max-width: 760px;
    padding: clamp(26px, 5vw, 52px);
    border-top: 3px solid var(--accent);
  }

  .coffee {
    margin-top: 6px;
    min-height: 50px;
    padding-inline: 26px;
    font-size: 1.05rem;
  }

  .coffee :global(svg) {
    width: 20px;
    height: 20px;
  }

  .soon {
    padding: 12px 16px;
    border-radius: var(--radius);
    border: 1px dashed var(--line);
    color: var(--text-muted);
  }

  .section-tight {
    padding-bottom: 24px;
  }

  h2 {
    margin-bottom: 22px;
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ways li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 24px;
  }
</style>
