---
// Screenshot thumbnails that open full size in a popover. No JavaScript: the popover
// attribute handles opening, Esc and clicking outside to close.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Shot } from '../data/addons';
import { widthsFor } from '../lib/images';

interface Props {
  id: string;
  shots: Shot[];
}
const { id, shots } = Astro.props;
---

<ul class="gallery">
  {
    shots.map((shot, i) => (
      <li>
        <figure>
          <button class="thumb" type="button" popovertarget={`${id}-${i}`}>
            <Image
              src={shot.src}
              alt={shot.alt}
              widths={widthsFor(shot.src, [360, 540, 720])}
              sizes="(min-width: 1120px) 360px, (min-width: 720px) 45vw, calc(100vw - 32px)"
            />
            <span class="zoom">
              <Icon name="zoom" />
              <span class="visually-hidden">Open full size</span>
            </span>
          </button>
          <figcaption>{shot.alt}</figcaption>
        </figure>
        <div id={`${id}-${i}`} class="lightbox" popover>
          <Image
            src={shot.src}
            alt={shot.alt}
            loading="lazy"
            widths={widthsFor(shot.src, [960, 1440])}
            sizes="94vw"
          />
          <button class="close" type="button" popovertarget={`${id}-${i}`} popovertargetaction="hide">
            <span aria-hidden="true">×</span>
            <span class="visually-hidden">Close</span>
          </button>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  figure {
    margin: 0;
    display: grid;
    gap: 10px;
  }

  .thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #050403;
    cursor: zoom-in;
  }

  /* Whole screenshot, never upscaled: the tracker shots are only ~310px wide. */
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: scale-down;
    transition: transform 0.25s;
  }

  .thumb:hover img {
    transform: scale(1.03);
  }

  .thumb:hover {
    border-color: var(--accent);
  }

  .zoom {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.7);
    color: var(--text);
  }

  .zoom :global(svg) {
    width: 18px;
    height: 18px;
  }

  figcaption {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .lightbox {
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #000;
    max-width: 94vw;
    max-height: 92vh;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgb(5 4 3 / 0.86);
  }

  .lightbox img {
    max-width: 94vw;
    max-height: 92vh;
    width: auto;
    height: auto;
    border-radius: var(--radius);
  }

  .close {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--text);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  @media (max-width: 600px) {
    .close {
      top: 6px;
      right: 6px;
    }
  }

  .close:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
