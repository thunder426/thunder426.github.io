---
// The Timearc mark: an arc of a clock face with its hands. Also public/favicon.svg.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  aria-hidden="true"
>
  <path d="M8.2 23.8A11 11 0 1 1 23.8 23.8" stroke-width="2.6"></path>
  <path d="M16 16V9.5M16 16l4.6 2.7" stroke-width="2.2"></path>
  <circle cx="23.8" cy="23.8" r="1.9" fill="currentColor" stroke="none"></circle>
</svg>
