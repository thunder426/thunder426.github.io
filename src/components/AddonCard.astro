---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Addon } from '../data/addons';
import { latestVersion } from '../lib/changelog';

interface Props {
  addon: Addon;
}
const { addon } = Astro.props;
const href = `/addons/${addon.slug}/`;
---

<article class="addon-card card" data-addon={addon.slug}>
  <a class="logo" href={href} tabindex="-1" aria-hidden="true">
    <Image src={addon.logo} alt="" width={128} height={128} densities={[1, 2]} />
  </a>
  <div class="body">
    <h3><a href={href}>{addon.name}</a></h3>
    <p class="tagline">{addon.tagline}</p>
    <ul class="chips">
      <li class="chip chip-accent">v{latestVersion(addon.slug)}</li>
      <li class="chip"><code>{addon.command}</code></li>
    </ul>
  </div>
  <div class="actions">
    <a class="button button-ghost" href={href}>Details</a>
    <a class="button button-primary" href={addon.curseforge}>
      CurseForge <Icon name="external" />
      <span class="visually-hidden">: {addon.name}</span>
    </a>
  </div>
</article>

<style>
  .addon-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 24px;
    border-top: 3px solid var(--accent);
    transition: border-color 0.15s, transform 0.15s;
  }

  .addon-card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line-soft));
    border-top-color: var(--accent);
  }

  .logo {
    display: block;
    width: 112px;
    height: 112px;
    border-radius: 22px;
    overflow: hidden;
    background: radial-gradient(circle at 50% 40%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%);
  }

  .logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .body {
    display: grid;
    gap: 10px;
    flex: 1;
    align-content: start;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .tagline {
    color: var(--text-muted);
  }

  .chips code {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
  }

  .actions .button {
    flex: 1;
  }
</style>
